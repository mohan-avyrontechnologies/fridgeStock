# Native apps: your own Firebase files and API address (they belong to your project, not the repository)
client/android/app/google-services.json
client/ios/App/App/GoogleService-Info.plist
client/.env.native
client/android/app/build/
client/ios/App/build/
client/ios/App/Pods/
client/ios/DerivedData/

# AI evaluation: real samples, prices and photos stay local (the *.example.json files are committed)
server/scripts/ai-eval/images/
server/scripts/ai-eval/samples.json
server/scripts/ai-eval/prices.json

# Design review screenshots (regenerate with npm run design:shots)
docs/design-review/
