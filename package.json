{
  "name": "cook-first",
  "version": "2.23.0",
  "private": true,
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "db:py": "node server-py/scripts/dev-mongo.mjs",
    "db:py:empty": "node server-py/scripts/dev-mongo.mjs --empty",
    "lint:py": "cd server-py && uv run ruff check . && uv run ruff format --check . && uv run pyright",
    "test:py": "cd server-py && uv run pytest",
    "build": "npm run build -w shared && npm run build -w server && npm run build -w client",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm test --workspaces",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:staging": "node scripts/check-staging.mjs",
    "design:shots": "node scripts/design-shots.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "type": "module"
}
