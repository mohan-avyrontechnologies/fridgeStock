# Copy to .env (never commit .env). The Python server reads the same settings as the TypeScript one; every
# value is optional in development. See server/.env.example for all of them, with notes.

# Port the API listens on. 4001 lets it run next to the TypeScript server on 4000.
PORT=4001
# MongoDB connection string. Leave empty in development to use the embedded MongoDB (data kept in
# server-py/.data, port 27028).
MONGO_URI=
# Required in production, and the same value as the TypeScript server's, so logins work on both.
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Browser origin allowed by CORS (comma-separate several)
CLIENT_ORIGIN=http://localhost:5173
# Whether this server runs the scheduled jobs (from Phase 4). Only one server sharing a database may have it on.
JOBS_ENABLED=true
