# Leave MONGODB_URI empty in development to use an embedded MongoDB stored in ./.data
MONGODB_URI=
PORT=4000
# Required in production. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173
# How often the reminder dispatcher sweeps for due reminders (minutes)
REMINDER_SWEEP_MINUTES=15
