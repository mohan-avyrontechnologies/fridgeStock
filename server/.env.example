# Copy to .env (never commit .env). Every value is optional in development.

# Port the API listens on
PORT=4000
# MongoDB connection string. Leave empty in development to use the embedded
# MongoDB (data kept in ./.data), or use docker compose:
#   MONGO_URI=mongodb://localhost:27017/cook-first
MONGO_URI=
# Required in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Browser origin allowed by CORS (comma-separate several)
CLIENT_ORIGIN=http://localhost:5173

# Web Push (Phase 3). Leave all three empty to keep reminders in-app only.
# Generate a key pair once with:  npm run vapid:keys -w server
# The public key is sent to browsers; the private key must stay secret.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services if something goes wrong: mailto: or https: URL
VAPID_SUBJECT=mailto:you@example.com

# Push to the Android and iOS apps (Capacitor), through Firebase Cloud Messaging.
# In the Firebase console: Project settings > Service accounts > Generate new private key, then copy these
# three values from the downloaded JSON file. Leave them empty to keep push to browsers only.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# The key with its line breaks written as \n, inside one line.
FIREBASE_PRIVATE_KEY=

# iPhone and iPad notifications go through Firebase too, using an Apple APNs key. The key itself is uploaded
# in the Firebase console (Project settings > Cloud Messaging > Apple app configuration > APNs authentication
# key), not here. These record the values you used there; only the bundle id is read by the server (as the
# APNs topic).
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=

# Where this API is reached from outside, for example https://cook-first-api.onrender.com/api. The Used and
# Snooze buttons on Android notifications call it. Optional: without it they just open the app.
PUBLIC_API_URL=

# AI features (Phase 4): Claude API via @anthropic-ai/sdk. Leave the key empty
# to turn AI features off. Never commit a real key: put it in server/.env only.
ANTHROPIC_API_KEY=
# Model ID. Empty means the default, claude-sonnet-5-5 (Claude Sonnet 5.5).
AI_MODEL=

# Barcode look-ups (Phase 6). Empty means Open Food Facts (free, no key).
PRODUCT_LOOKUP_URL=

# Photo Check (Phase 7): set to "on" to turn it on. It also needs ANTHROPIC_API_KEY.
PHOTO_CHECK=
