{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    // Resolve @fridgestock/shared from its TypeScript source during development and tests.
    "customConditions": ["source"],
    // @fridgestock/shared reads its data from JSON files (shared/data).
    "resolveJsonModule": true
  },
  "include": ["src", "vitest.config.ts"]
}
