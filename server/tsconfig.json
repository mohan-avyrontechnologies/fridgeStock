{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    // Resolve @cook-first/shared from its TypeScript source during development and tests.
    "customConditions": ["source"]
  },
  "include": ["src", "vitest.config.ts"]
}
