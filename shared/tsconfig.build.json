{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    // The JSON in data/ is part of the build, so the output is dist/src and dist/data.
    "outDir": "dist",
    "rootDir": "."
  },
  "include": ["src", "data"],
  "exclude": ["src/**/*.test.ts", "src/testCases.ts"]
}
